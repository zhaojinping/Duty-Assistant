{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "records-kit/protocol/1.5/record_envelope.schema.json",
  "title": "RecordEnvelope",
  "description": "输入协议（docs/design.md §5）。手写权威文件；operation 相关的条件必填由 records_kit.protocol.envelope 实施（§5 表内星号项）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "protocol_version", "operation", "station", "now"],
  "properties": {
    "protocol": { "const": "records-kit" },
    "protocol_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "operation": {
      "type": "string",
      "enum": ["create", "confirm", "return", "correct", "void", "archive", "alarm_ack", "cycle_probe"]
    },
    "record_type": { "type": "string", "minLength": 1, "description": "registry 键；cycle_probe 可省 = 全部类型逐一探测" },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["station_id", "station_name"],
      "properties": {
        "station_id": { "type": "string", "minLength": 1 },
        "station_name": { "type": "string", "minLength": 1 }
      }
    },
    "occurred_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$" },
    "now": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$" },
    "create_seq": { "type": "integer", "minimum": 1 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_uid", "lifecycle", "rev"],
      "properties": {
        "record_uid": { "type": "string", "minLength": 1 },
        "lifecycle": { "type": "string", "enum": ["draft", "confirmed", "archived", "voided"] },
        "rev": { "type": "integer", "minimum": 1 }
      }
    },
    "payload": { "type": "object" },
    "history": { "type": "array", "items": { "$ref": "#/$defs/history_row" } },
    "ledger_view": { "$ref": "#/$defs/ledger_view" },
    "alarm_history": { "type": "array", "items": { "$ref": "#/$defs/alarm_row" } },
    "baselines": { "type": "array", "items": { "$ref": "#/$defs/baseline" } },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "attachments_ref": { "type": "array", "items": { "$ref": "#/$defs/attachment" } },
    "submitted_by": { "type": "string", "minLength": 1 },
    "confirmations": { "type": "array", "items": { "$ref": "#/$defs/confirmation" } },
    "return_reason": { "type": "string", "minLength": 1 },
    "archive_ref": { "type": "string", "minLength": 1 },
    "archived_by": { "type": "string", "minLength": 1 },
    "void_reason": { "type": "string", "minLength": 1 },
    "voided_by": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "history_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurred_at", "digest", "lifecycle", "fields"],
      "properties": {
        "occurred_at": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 },
        "lifecycle": { "const": "archived" },
        "fields": { "type": "object" }
      }
    },
    "ledger_view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "confirmed_digests": { "type": "array", "items": { "type": "string" } },
        "same_type_records": { "type": "array", "items": { "$ref": "#/$defs/ledger_row" } },
        "linked_records": { "type": "array", "items": { "$ref": "#/$defs/linked_row" } }
      }
    },
    "ledger_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_uid", "lifecycle", "rev", "fields"],
      "properties": {
        "record_uid": { "type": "string", "minLength": 1 },
        "lifecycle": { "type": "string", "enum": ["draft", "confirmed", "archived", "voided"] },
        "rev": { "type": "integer", "minimum": 1 },
        "occurred_at": { "type": "string" },
        "digest": { "type": "string" },
        "fields": { "type": "object" },
        "confirmed_fields": { "type": "object" },
        "dedupe_key_values": { "type": "object" }
      }
    },
    "linked_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_uid", "lifecycle", "rev", "fields"],
      "properties": {
        "record_uid": { "type": "string", "minLength": 1 },
        "lifecycle": { "type": "string", "enum": ["draft", "confirmed", "archived", "voided"] },
        "rev": { "type": "integer", "minimum": 1 },
        "occurred_at": { "type": "string" },
        "digest": { "type": "string" },
        "fields": { "type": "object" }
      }
    },
    "alarm_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "occur_count"],
      "properties": {
        "fingerprint": { "type": "string", "minLength": 1 },
        "first_seen_at": { "type": "string" },
        "occur_count": { "type": "integer", "minimum": 0 },
        "last_status": { "type": "string" },
        "escalated_count": { "type": "integer", "minimum": 0 }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "kind", "name", "data"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "data": { "type": "object" }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "record_uid"],
      "properties": {
        "type": { "type": "string", "enum": ["retest_of", "pairs_with", "supersedes", "references"] },
        "record_uid": { "type": "string", "minLength": 1 }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "type": "string", "enum": ["photo", "file", "csv", "pdf"] },
        "ref": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "by", "at"],
      "properties": {
        "slot": { "type": "string", "minLength": 1 },
        "by": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$" }
      }
    }
  }
}
